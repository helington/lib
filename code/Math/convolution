//GCD MOD:
template<typename T>
vector<T> gcdConvolution(vector<T> a, vector<T> b, T mod)
{
    int n = a.size()-1;

    vector<T> A(n+1);
    vector<T> B(n+1);
    vector<T> D(n+1);

    for(int i=1;i<=n;i++)
    {
        for(int j=i;j<=n;j+=i)
        {
            A[i] += a[j];
            B[i] += b[j];
            A[i] %= mod;
            B[i] %= mod;
        }

        D[i] = A[i] * B[i];
        D[i] %= mod;
    }

    vector<T> d(n+1);

    for(int i=n;i>=1;i--)
    {
        d[i] = D[i];

        for(int j=2*i;j<=n;j+=i)
        {
            d[i] -= d[j];
            d[i] = (d[i] + mod) % mod;
        }
    }

    return d;
}

//LCM MOD:
template<typename T>
vector<T> lcmConvolution(vector<T> a, vector<T> b, T mod)
{
    int n = a.size()-1;

    vector<T> A(n+1);
    vector<T> B(n+1);
    vector<T> D(n+1);

    for(int i=1;i<=n;i++)
    {
        for(int j=i;j<=n;j+=i)
        {
            A[j] += a[i];
            B[j] += b[i];

            A[j] %= mod;
            B[j] %= mod;
        }
    }

    for(int i=1;i<=n;i++)
        D[i] = A[i] * B[i] % mod;

    vector<T> d = D;

    for(int i=1;i<=n;i++)
    {
        for(int j=2*i;j<=n;j+=i)
        {
            d[j] -= d[i];
            d[j] = (d[j]+mod)%mod;
